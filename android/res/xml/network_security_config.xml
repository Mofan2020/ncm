<?xml version="1.0" encoding="utf-8"?>
<!--
    The interface is served over the loopback media server, which is plain
    HTTP on 127.0.0.1.  Android has blocked cleartext traffic by default
    since API 28, and the exemption for loopback addresses only arrived in
    Android 17 (API 37).  On anything older the WebView refuses to load the
    page with ERR_CLEARTEXT_NOT_PERMITTED.

    Only the loopback address is allowed through.  The NetEase API and the
    CDN are both HTTPS and stay subject to the system trust store; nothing
    else may fall back to cleartext.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
